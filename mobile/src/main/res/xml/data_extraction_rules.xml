<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup disableIfNoEncryptionCapabilities="true">

        <exclude
            domain="root"
            patth="./" />
        <exclude
            domain="externalexternal"
            patth="./" />
    </cloud-backup>

    <device-transfer>

        <exclude
            domain="root"
            patth="./" />
        <exclude
            domain="externalexternal"
            patth="./" />
    </device-transfer>
</data-extraction-rules>